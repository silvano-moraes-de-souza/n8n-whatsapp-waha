# Copy to .env and fill in. .env is gitignored.
# Generate random values with:  openssl rand -hex 32

POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

REDIS_PASSWORD=

# Protects the WAHA API and dashboard. Also paste it into the "WAHA account" credential in n8n.
WAHA_API_KEY=

# Encrypts the credentials n8n stores in Postgres. Keep it stable and private:
# losing it makes every saved credential unreadable.
N8N_ENCRYPTION_KEY=

# LLM providers are configured as n8n credentials (UI), not here:
#   OpenRouter account, Groq account, Redis account, WAHA account
